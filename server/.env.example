# Copy to server/.env and fill in. Placeholders only: never commit real secrets.

# --- Backend (server/) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://linkshield_user:CHANGE_ME@localhost:5432/linkshield
# Used only by `npm test`; the test suite wipes this database, its name must contain "test".
TEST_DATABASE_URL=postgres://linkshield_user:CHANGE_ME@localhost:5432/linkshield_test
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-0123456789
ML_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# TRUST_PROXY=1

# --- Admin bootstrap (only for `npm run create-admin`; remove afterwards) ---
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# --- ML service (ml-service/) - all optional, defaults are repo-relative ---
# LINKSHIELD_RAW_DATASET=../data/raw/PhiUSIIL_Phishing_URL_Dataset.csv
# LINKSHIELD_MODEL_PATH=./models/linkshield_model.joblib
